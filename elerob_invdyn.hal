setp colli.baseInertialParamsTop.44 -0.000010035290345
setp colli.baseInertialParamsTop.45 -0.000026198811145
setp colli.baseInertialParamsTop.46 0.000330395870041
setp colli.baseInertialParamsTop.47 -0.006932942313156

setp colli.payloadDiff	0


setp colli.gravity 9.80665
setp colli.linkVec.00 0.236
setp colli.linkVec.01 0.236
setp colli.linkVec.02 0.128
setp colli.linkVec.03 0.126
setp colli.linkVec.04 0
setp colli.residualStaThreVec.00 0.2
setp colli.residualStaThreVec.01 0.2
setp colli.residualStaThreVec.02 0.28
setp colli.residualStaThreVec.03 0.15
setp colli.residualStaThreVec.04 0.1
setp colli.residualStaThreVec.05 0.1
setp colli.picount 4500
setp colli.cutoffFreq 10
setp colli.cutoffFreqDynThre 200
setp colli.rmsFilterHorizon 4
setp colli.rmsFilterHorizonDyn 20

#setp colli.enable 1

net colli-res0 colli.residualDeciVec.00 => pro600.joint0_colli_res
net colli-res1 colli.residualDeciVec.01 => pro600.joint1_colli_res
net colli-res2 colli.residualDeciVec.02 => pro600.joint2_colli_res
net colli-res3 colli.residualDeciVec.03 => pro600.joint3_colli_res
net colli-res4 colli.residualDeciVec.04 => pro600.joint4_colli_res
net colli-res5 colli.residualDeciVec.05 => pro600.joint5_colli_res

#####Act
net J0posfb => colli.qVec.00
net J1posfb => colli.qVec.01
net J2posfb => colli.qVec.02
net J3posfb => colli.qVec.03
net J4posfb => colli.qVec.04
net J5posfb => colli.qVec.05


net j0-act-vel pro600.joint0_velfb => colli.qdotVec.00
net j1-act-vel pro600.joint1_velfb => colli.qdotVec.01
net j2-act-vel pro600.joint2_velfb => colli.qdotVec.02
net j3-act-vel pro600.joint3_velfb => colli.qdotVec.03
net j4-act-vel pro600.joint4_velfb => colli.qdotVec.04
net j5-act-vel pro600.joint5_velfb => colli.qdotVec.05

#####Cmd
# (colli.qCmdVec wired via mux-gen.00.out-float etc above)

net j0_cmd_vel => colli.qdotCmdVec.00
net j1_cmd_vel => colli.qdotCmdVec.01
net j2_cmd_vel => colli.qdotCmdVec.02
net j3_cmd_vel => colli.qdotCmdVec.03
net j4_cmd_vel => colli.qdotCmdVec.04
net j5_cmd_vel => colli.qdotCmdVec.05

net j0_cmd_vel joint.0.vel-cmd => ddt.0.in
net j1_cmd_vel joint.1.vel-cmd => ddt.1.in
net j2_cmd_vel joint.2.vel-cmd => ddt.2.in
net j3_cmd_vel joint.3.vel-cmd => ddt.3.in
net j4_cmd_vel joint.4.vel-cmd => ddt.4.in
net j5_cmd_vel joint.5.vel-cmd => ddt.5.in

net j0_acc ddt.0.out => colli.qdottCmdVec.00
net j1_acc ddt.1.out => colli.qdottCmdVec.01
net j2_acc ddt.2.out => colli.qdottCmdVec.02
net j3_acc ddt.3.out => colli.qdottCmdVec.03
net j4_acc ddt.4.out => colli.qdottCmdVec.04
net j5_acc ddt.5.out => colli.qdottCmdVec.05

# a, b, c axes correspond to rx, ry, rz
# ddt.N.out is output value (can read)
net axisx_cmd_vel axis.x.pos-cmd => ddt.6.in
net axisy_cmd_vel axis.y.pos-cmd => ddt.7.in
net axisz_cmd_vel axis.z.pos-cmd => ddt.8.in
net axisa_cmd_vel axis.a.pos-cmd => ddt.9.in
net axisb_cmd_vel axis.b.pos-cmd => ddt.10.in
net axisc_cmd_vel axis.c.pos-cmd => ddt.11.in

net sig0-jtorq0-fb pro600.joint0_torqfb => colli.torqVec.00
net sig1-jtorq1-fb pro600.joint1_torqfb => colli.torqVec.01
net sig2-jtorq2-fb pro600.joint2_torqfb => colli.torqVec.02
net sig3-jtorq3-fb pro600.joint3_torqfb => colli.torqVec.03
net sig4-jtorq4-fb pro600.joint4_torqfb => colli.torqVec.04
net sig5-jtorq5-fb pro600.joint5_torqfb => colli.torqVec.05
###################################collision params end ######################################

# estop loopback
net estop-loop iocontrol.0.user-enable-out iocontrol.0.emc-enable-in

# create signals for tool loading loopback
net tool-prep-loop iocontrol.0.tool-prepare iocontrol.0.tool-prepared
net tool-change-loop iocontrol.0.tool-change iocontrol.0.tool-changed

net estop-loop => pro600.svr_en
# Collision abort: colli can false-trigger at startup (q=0, residual mismatch) and turn off robot.
# BYPASS active for MPC testing - robot was turning off. Re-enable for production safety.
# net colli-out colli.output => motion.ex-abort pro600.collidet_res
loadrt and2 count=1
addf and2.0 servo-thread
setp and2.0.in1 0
net colli-out colli.output => and2.0.in0
net colli-bypass and2.0.out => motion.ex-abort pro600.collidet_res
# PID enable: gated ONLY by invdyn.enable (NOT by motion.motion-enabled).
# This prevents PID spike at startup: the motor encoders report stale positions
# until CAN init completes, causing 90° errors that produce 2800°/s PID output.
# By gating PIDs on invdyn.enable, we wait until Python has confirmed valid feedback
# and pre-loaded matching MPC commands before PIDs start computing.
net sig-mot-en motion.motion-enabled => pro600.motion_enabled
net invdyn-enable => pid.0.enable pid.1.enable pid.2.enable pid.3.enable pid.4.enable pid.5.enable

net sig-en pro600.svr_enabled => motion.enable colli.enable
