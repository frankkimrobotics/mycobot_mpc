# core HAL config file for simulation - 6 axis

# load RT modules
loadrt pandakins

loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD traj_period_nsec=[EMCMOT]TRAJ_PERIOD num_joints=[KINS]JOINTS num_dio=64 num_aio=64
loadrt threads name1=slow-thread period1=20000000
loadrt ddt count=12
loadrt or2 count=1
loadrt pid num_chan=6
loadrt mux_generic config="ff2,ff2,ff2,ff2,ff2,ff2,ff2,ff2,ff2,ff2,ff2,ff2"

#motor update
loadrt hal_ele_master600
loadrt collidet_panda
loadusr -Wn invdyn python /home/pi/Desktop/mpc/invdyn_hal.py

# add motion controller functions to servo thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf mux-gen.00 servo-thread
addf mux-gen.01 servo-thread
addf mux-gen.02 servo-thread
addf mux-gen.03 servo-thread
addf mux-gen.04 servo-thread
addf mux-gen.05 servo-thread
addf mux-gen.06 servo-thread
addf mux-gen.07 servo-thread
addf mux-gen.08 servo-thread
addf mux-gen.09 servo-thread
addf mux-gen.10 servo-thread
addf mux-gen.11 servo-thread

addf pid.0.do-pid-calcs slow-thread
addf pid.1.do-pid-calcs slow-thread
addf pid.2.do-pid-calcs slow-thread
addf pid.3.do-pid-calcs slow-thread
addf pid.4.do-pid-calcs slow-thread
addf pid.5.do-pid-calcs slow-thread

##addf siggen.0.update servo-thread
addf ddt.0 servo-thread
addf ddt.1 servo-thread
addf ddt.2 servo-thread
addf ddt.3 servo-thread
addf ddt.4 servo-thread
addf ddt.5 servo-thread
addf ddt.6 servo-thread
addf ddt.7 servo-thread
addf ddt.8 servo-thread
addf ddt.9 servo-thread
addf ddt.10 servo-thread
addf ddt.11 servo-thread

addf or2.0 servo-thread

addf pro_socketcan.update slow-thread
#addf pro_serial.update serial-thread

#Robot ID
#Elephant5 ID: 101
#Panda3 ID:    201
#Panda5 ID:    202
#Cat3 ID:      301
# Pro600: 502
# Pro630: 503
setp motion.analog-in-55 503

setp pro600.motor_time_interval 20

setp pid.0.Pgain     60
setp pid.0.Igain     0
setp pid.0.Dgain     0.01
setp pid.0.bias      0
setp pid.0.FF0       0
setp pid.0.FF1       0
setp pid.0.FF2       0
setp pid.0.deadband  0.0001
setp pid.0.maxoutput 2800

setp pid.1.Pgain     50
setp pid.1.Igain     0
setp pid.1.Dgain     0.01
setp pid.1.bias      0
setp pid.1.FF0       0
setp pid.1.FF1       0
setp pid.1.FF2       0
setp pid.1.deadband  0.0001
setp pid.1.maxoutput 2800

setp pid.2.Pgain     60
setp pid.2.Igain     0
setp pid.2.Dgain     0.01
setp pid.2.bias      0
setp pid.2.FF0       0
setp pid.2.FF1       0
setp pid.2.FF2       0
setp pid.2.deadband  0.0001
setp pid.2.maxoutput 2800

setp pid.3.Pgain     60
setp pid.3.Igain     0
setp pid.3.Dgain     0.01
setp pid.3.bias      0
setp pid.3.FF0       0
setp pid.3.FF1       0
setp pid.3.FF2       0
setp pid.3.deadband  0.0001
setp pid.3.maxoutput 2800

setp pid.4.Pgain     60
setp pid.4.Igain     0
setp pid.4.Dgain     0.01
setp pid.4.bias      0
setp pid.4.FF0       0
setp pid.4.FF1       0
setp pid.4.FF2       0
setp pid.4.deadband  0.0001
setp pid.4.maxoutput 2800

setp pid.5.Pgain     60
setp pid.5.Igain     0
setp pid.5.Dgain     0.01
setp pid.5.bias      0
setp pid.5.FF0       0
setp pid.5.FF1       0
setp pid.5.FF2       0
setp pid.5.deadband  0.0001
setp pid.5.maxoutput 2800

# Pro630
setp pandakins.D1 205
setp pandakins.A2 269
setp pandakins.A3 266
setp pandakins.D4 88
setp pandakins.D5 95
setp pandakins.D6 53

setp pandakins.singularthr 100000

# joint_polarity
setp pro600.joint0_pos_polarity 1
setp pro600.joint1_pos_polarity 1
setp pro600.joint2_pos_polarity 1
setp pro600.joint3_pos_polarity 1
setp pro600.joint4_pos_polarity 1
setp pro600.joint5_pos_polarity 1

# enc_scale = 360/(524288*100)
setp pro600.joint0_enc_scale 0.0000068665
setp pro600.joint1_enc_scale 0.0000068665
setp pro600.joint2_enc_scale -0.0000068665
setp pro600.joint3_enc_scale -0.0000068665
setp pro600.joint4_enc_scale -0.0000068665
setp pro600.joint5_enc_scale -0.0000068665

# vel_scale = 524288*0.001/60
setp pro600.joint0_vel_scale 8.7381333333
setp pro600.joint1_vel_scale 8.7381333333
setp pro600.joint2_vel_scale -8.7381333333
setp pro600.joint3_vel_scale -8.7381333333
setp pro600.joint4_vel_scale -8.7381333333
setp pro600.joint5_vel_scale -8.7381333333

# velocity feedback
setp pro600.joint0_vel_enc_scale 0.0068849
setp pro600.joint1_vel_enc_scale 0.0068849
setp pro600.joint2_vel_enc_scale -0.0068849
setp pro600.joint3_vel_enc_scale -0.0068849
setp pro600.joint4_vel_enc_scale -0.0068849
setp pro600.joint5_vel_enc_scale -0.0068849

#2024/03/21-002#
setp pro600.joint0_home_offset 7379.277053
setp pro600.joint1_home_offset 7288.683530
setp pro600.joint2_home_offset -7392.865902
setp pro600.joint3_home_offset -7481.763784
setp pro600.joint4_home_offset -7356.179346
setp pro600.joint5_home_offset -7365.860644

# 512*524288 = 512rpm
#setp pro600.motor_accelaration 268435456
setp pro600.motor_accelaration  2097152

# InvDyn bypass: mux_generic switches between motion (in0) and invdyn (in1) when invdyn.enable=1 (sel-bit-00=TRUE)
net sig0-mot-pos-cmd joint.0.motor-pos-cmd => mux-gen.00.in-float-00
net invdyn-j0-cmd invdyn.joint0_pos_cmd => mux-gen.00.in-float-01
net invdyn-enable invdyn.enable => mux-gen.00.sel-bit-00
net pid0-cmd mux-gen.00.out-float => pid.0.command pro600.joint0_motor_poscmd colli.qCmdVec.00

net sig1-mot-pos-cmd joint.1.motor-pos-cmd => mux-gen.01.in-float-00
net invdyn-j1-cmd invdyn.joint1_pos_cmd => mux-gen.01.in-float-01
net invdyn-enable => mux-gen.01.sel-bit-00
net pid1-cmd mux-gen.01.out-float => pid.1.command pro600.joint1_motor_poscmd colli.qCmdVec.01

net sig2-mot-pos-cmd joint.2.motor-pos-cmd => mux-gen.02.in-float-00
net invdyn-j2-cmd invdyn.joint2_pos_cmd => mux-gen.02.in-float-01
net invdyn-enable => mux-gen.02.sel-bit-00
net pid2-cmd mux-gen.02.out-float => pid.2.command pro600.joint2_motor_poscmd colli.qCmdVec.02

net sig3-mot-pos-cmd joint.3.motor-pos-cmd => mux-gen.03.in-float-00
net invdyn-j3-cmd invdyn.joint3_pos_cmd => mux-gen.03.in-float-01
net invdyn-enable => mux-gen.03.sel-bit-00
net pid3-cmd mux-gen.03.out-float => pid.3.command pro600.joint3_motor_poscmd colli.qCmdVec.03

net sig4-mot-pos-cmd joint.4.motor-pos-cmd => mux-gen.04.in-float-00
net invdyn-j4-cmd invdyn.joint4_pos_cmd => mux-gen.04.in-float-01
net invdyn-enable => mux-gen.04.sel-bit-00
net pid4-cmd mux-gen.04.out-float => pid.4.command pro600.joint4_motor_poscmd colli.qCmdVec.04

net sig5-mot-pos-cmd joint.5.motor-pos-cmd => mux-gen.05.in-float-00
net invdyn-j5-cmd invdyn.joint5_pos_cmd => mux-gen.05.in-float-01
net invdyn-enable => mux-gen.05.sel-bit-00
net pid5-cmd mux-gen.05.out-float => pid.5.command pro600.joint5_motor_poscmd colli.qCmdVec.05


# Velocity mux: select between PID output (in0, normal) and MPC velocity (in1, MPC active)
# When invdyn.enable=FALSE: pro600 gets PID velocity (normal servo loop)
# When invdyn.enable=TRUE:  pro600 gets InvDyn velocity directly (InvDyn has full control)
net sig0-vel-cmd pid.0.output => mux-gen.06.in-float-00
net invdyn-j0-vel invdyn.joint0_vel_cmd => mux-gen.06.in-float-01
net invdyn-enable => mux-gen.06.sel-bit-00
net vel0-out mux-gen.06.out-float => pro600.joint0_poscmd

net sig1-vel-cmd pid.1.output => mux-gen.07.in-float-00
net invdyn-j1-vel invdyn.joint1_vel_cmd => mux-gen.07.in-float-01
net invdyn-enable => mux-gen.07.sel-bit-00
net vel1-out mux-gen.07.out-float => pro600.joint1_poscmd

net sig2-vel-cmd pid.2.output => mux-gen.08.in-float-00
net invdyn-j2-vel invdyn.joint2_vel_cmd => mux-gen.08.in-float-01
net invdyn-enable => mux-gen.08.sel-bit-00
net vel2-out mux-gen.08.out-float => pro600.joint2_poscmd

net sig3-vel-cmd pid.3.output => mux-gen.09.in-float-00
net invdyn-j3-vel invdyn.joint3_vel_cmd => mux-gen.09.in-float-01
net invdyn-enable => mux-gen.09.sel-bit-00
net vel3-out mux-gen.09.out-float => pro600.joint3_poscmd

net sig4-vel-cmd pid.4.output => mux-gen.10.in-float-00
net invdyn-j4-vel invdyn.joint4_vel_cmd => mux-gen.10.in-float-01
net invdyn-enable => mux-gen.10.sel-bit-00
net vel4-out mux-gen.10.out-float => pro600.joint4_poscmd

net sig5-vel-cmd pid.5.output => mux-gen.11.in-float-00
net invdyn-j5-vel invdyn.joint5_vel_cmd => mux-gen.11.in-float-01
net invdyn-enable => mux-gen.11.sel-bit-00
net vel5-out mux-gen.11.out-float => pro600.joint5_poscmd


# loop position commands back to motion module feedback
net J0posfb pro600.joint0_posfb => joint.0.motor-pos-fb pid.0.feedback
net J1posfb pro600.joint1_posfb => joint.1.motor-pos-fb pid.1.feedback
net J2posfb pro600.joint2_posfb => joint.2.motor-pos-fb pid.2.feedback
net J3posfb pro600.joint3_posfb => joint.3.motor-pos-fb pid.3.feedback
net J4posfb pro600.joint4_posfb => joint.4.motor-pos-fb pid.4.feedback
net J5posfb pro600.joint5_posfb => joint.5.motor-pos-fb pid.5.feedback

###############################joint limit##########################
net J1PosLim joint.0.pos-limit => pro600.joint0_pos_lim
net J1NegLim joint.0.neg-limit => pro600.joint0_neg_lim
net J2PosLim joint.1.pos-limit => pro600.joint1_pos_lim
net J2NegLim joint.1.neg-limit => pro600.joint1_neg_lim
net J3PosLim joint.2.pos-limit => pro600.joint2_pos_lim
net J3NegLim joint.2.neg-limit => pro600.joint2_neg_lim
net J4PosLim joint.3.pos-limit => pro600.joint3_pos_lim
net J4NegLim joint.3.neg-limit => pro600.joint3_neg_lim
net J5PosLim joint.4.pos-limit => pro600.joint4_pos_lim
net J5NegLim joint.4.neg-limit => pro600.joint4_neg_lim
net J6PosLim joint.5.pos-limit => pro600.joint5_pos_lim
net J6NegLim joint.5.neg-limit => pro600.joint5_neg_lim


##########################Torque##################################
setp pro600.joint0_rated_torq 1.86
setp pro600.joint1_rated_torq 1.86
setp pro600.joint2_rated_torq 1.86
setp pro600.joint3_rated_torq 0.5
setp pro600.joint4_rated_torq 0.5
setp pro600.joint5_rated_torq 0.5

setp pro600.joint0_torque_scale -57676.0563381
setp pro600.joint1_torque_scale -57676.0563381
setp pro600.joint2_torque_scale 57676.0563381
setp pro600.joint3_torque_scale -57982.300885
setp pro600.joint4_torque_scale -57982.300885
setp pro600.joint5_torque_scale -57982.300885


#a torque：torque-constant * I
#b torque: 9550 * (1.732 * 48 * I * 0.85 / 1000) / 3000
#I: 2 * ipeak /65520 * cur_IU = 2 * 16 / 65520 * cur_IU
setp pro600.joint0_torque_enc_scale -0.000017338217338
